{
  "name": "grapi",
  "version": "0.0.1",
  "description": "Personal pi extensions",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/Grapedge/grapi#readme",
  "bugs": {
    "url": "https://github.com/Grapedge/grapi/issues"
  },
  "license": "MIT",
  "author": "grapedge@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grapedge/grapi.git"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers.ts",
    "!src/**/.gitkeep"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@earendil-works/pi-tui": "^0.80.6",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pi": {
    "extensions": [
      "./src/web/index.ts"
    ]
  }
}
