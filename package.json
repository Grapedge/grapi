{
  "name": "grapi",
  "version": "0.1.0",
  "description": "Personal pi extensions",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/Grapedge/grapi#readme",
  "bugs": {
    "url": "https://github.com/Grapedge/grapi/issues"
  },
  "license": "MIT",
  "author": "grapedge@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grapedge/grapi.git"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
